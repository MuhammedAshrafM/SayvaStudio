{
  "name": "sayva-studio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "depcruise": "depcruise packages apps tooling",
    "graph": "depcruise --output-type mermaid --collapse \"^(packages|apps)/[^/]+\" -x \"^node_modules|\\.next|next-env|next\\.config|(^|/)path$|(^|/)url$|typescript-eslint\" packages apps"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@sayva/eslint-config": "workspace:*",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
